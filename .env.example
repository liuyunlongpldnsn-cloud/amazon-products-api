# Earbuds pipeline optional configs
# Preferred source order, comma separated.
PIPELINE_SOURCES=amazon,bestbuy

# Default query when no --query is provided.
DEFAULT_QUERY=wireless earbuds

# API auth (optional; if empty, auth middleware allows all requests)
X_API_KEY=replace-with-your-api-key

# DB connection used by FastAPI app
DATABASE_URL=sqlite:///data/app.db

# Optional external source key
KEEPA_API_KEY=replace-with-your-keepa-key
